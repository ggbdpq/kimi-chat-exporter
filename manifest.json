{
  "manifest_version": 3,
  "name": "Kimi Chat Exporter",
  "version": "1.1.0",
  "description": "Export your entire Kimi chat history to one offline ZIP: Markdown, raw JSON, thinking, tool calls, citations and all media.",
  "permissions": ["storage", "downloads", "scripting", "contextMenus"],
  "host_permissions": ["https://www.kimi.com/*", "https://*.kimi.com/*"],
  "background": {
    "service_worker": "lib/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Export Kimi chat history",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.kimi.com/*"],
      "js": ["lib/content.js"],
      "run_at": "document_idle"
    }
  ],
  "optional_host_permissions": ["<all_urls>"],
  "minimum_chrome_version": "127"
}
